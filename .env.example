OPENDART_API_KEY=your_opendart_key_here

# === LLM 백엔드 선택 ===
# anthropic (기본) | openrouter | nvidia | gemini
LLM_BACKEND=anthropic

# --- Anthropic 사용 시 ---
ANTHROPIC_API_KEY=your_anthropic_key_here
# (선택) 기본은 claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenRouter 사용 시 (무료 모델 가능) ---
# 키 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# 무료 모델 후보 (https://openrouter.ai/models?max_price=0 에서 최신 확인):
#   qwen/qwen-2.5-72b-instruct:free        ← 한국어 추천
#   deepseek/deepseek-chat:free            ← 한국어 양호
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free

# --- NVIDIA NIM 사용 시 (build.nvidia.com 무료 크레딧) ---
# 키 발급: https://build.nvidia.com (가입 후 우상단 Get API Key)
NVIDIA_API_KEY=your_nvidia_key_here
# 모델 후보 (https://build.nvidia.com/explore/discover):
#   meta/llama-3.3-70b-instruct            ← 다용도 추천
#   qwen/qwen2.5-7b-instruct               ← 빠르고 한국어 양호
#   nv-mistralai/mistral-nemo-12b-instruct ← 다국어
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Google Gemini 사용 시 (aistudio.google.com, 일 1500회 무료) ---
# 키 발급: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_key_here
# 모델 후보:
#   gemini-2.0-flash-exp        ← 빠름, 무료, 한국어 양호 (추천)
#   gemini-2.5-flash            ← 더 정확하나 느릴 수 있음
#   gemini-1.5-flash            ← 안정적인 구버전
# GEMINI_MODEL=gemini-2.0-flash-exp

# === 알림 ===
# (선택) ntfy.sh 푸시 — 토픽 이름은 비밀처럼 충분히 길고 유니크하게.
# 폰의 ntfy 앱(F-Droid 또는 Play 스토어)에서 같은 토픽을 구독하면 푸시가 도착.
# NTFY_TOPIC=my-very-long-unique-topic-name-2026

# === 텔레그램 봇 ===
# 1. @BotFather에 /newbot 으로 봇 생성, 토큰 받기
# 2. 토큰을 아래에 입력
# 3. 봇에 /start 보내고 봇이 응답으로 알려주는 chat_id를
#    ALLOWED_CHAT_IDS 에 입력 (콤마로 여러 명 가능)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ALLOWED_CHAT_IDS=123456789

LOG_LEVEL=INFO
DATA_DIR=./data
