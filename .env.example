OPENDART_API_KEY=your_opendart_key_here

# 모닝 브리핑(jobs/morning_brief.py) 사용 시 필요
ANTHROPIC_API_KEY=your_anthropic_key_here

# (선택) ntfy.sh 푸시 — 토픽 이름은 비밀처럼 충분히 길고 유니크하게.
# 폰의 ntfy 앱(F-Droid 또는 Play 스토어)에서 같은 토픽을 구독하면 푸시가 도착.
# NTFY_TOPIC=my-very-long-unique-topic-name-2026

LOG_LEVEL=INFO
DATA_DIR=./data
