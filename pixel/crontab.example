# Termux용 crontab 예시 — `crontab -e`에 붙여넣어 사용.
# Termux 환경의 PATH/홈 경로를 명시해야 cron 컨텍스트에서 동작합니다.

PATH=/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/lib
HOME=/data/data/com.termux/files/home
PROJ=/data/data/com.termux/files/home/projects/investment-hypothesis-tracker

# === GitOps 자동 동기화 (5분 간격) ===
# 원격 push를 가져오고 tasks/pending 큐를 실행한다.
# 보안 모델은 tasks/README.md 참고.
*/5 * * * * bash $PROJ/scripts/auto_sync.sh

# === 텔레그램 봇 워치독 (5분 간격) ===
# 봇이 죽어있으면 백그라운드로 다시 띄움. 살아있으면 no-op.
*/5 * * * * pgrep -f 'jobs.tg_bot' >/dev/null || (cd $PROJ && nohup python -m jobs.tg_bot >> logs/tg_bot.log 2>&1 &)

# 평일 오전 6:30 — 모닝 브리핑 (RSS 요약)
30 6 * * 1-5 cd $PROJ && python -m jobs.morning_brief >> logs/cron.log 2>&1

# 평일 오전 8시 — 신규 공시 체크
0 8 * * 1-5 cd $PROJ && python -m jobs.daily_disclosure_check >> logs/cron.log 2>&1

# 토요일 정오 — 한 주 누적 공시 재확인 (lookback 7일)
0 12 * * 6 cd $PROJ && python -c "from jobs.daily_disclosure_check import run; run(lookback_days=7)" >> logs/cron.log 2>&1
